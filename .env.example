# Optional — accounts + end-to-end-encrypted sync. Leave both unset and the
# app is purely local: no account UI, no network code loaded, CSP 'self' only.
# Setup guide: docs/cloud-setup.md
#
# Both values are PUBLIC by design (they ship to every browser; row-level
# security protects the data). NEVER put a service_role key here or anywhere.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
